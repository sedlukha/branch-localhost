{
  "name": "branch-localhost",
  "version": "0.2.0",
  "description": "Per-branch <branch>.localhost:<port> for local dev — deterministic port per git branch, free-port probing, env injection.",
  "keywords": [
    "dev",
    "devserver",
    "port",
    "git",
    "branch",
    "localhost",
    "subdomain",
    "worktree",
    "next.js",
    "monorepo",
    "cli"
  ],
  "license": "MIT",
  "author": "sedlukha",
  "homepage": "https://github.com/sedlukha/branch-localhost#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sedlukha/branch-localhost.git"
  },
  "bugs": {
    "url": "https://github.com/sedlukha/branch-localhost/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "branch-localhost": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json && node scripts/post-build.js",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "rimraf": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "packageManager": "pnpm@11.17.0"
}
